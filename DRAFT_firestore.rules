rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn();
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return (data.uid == request.auth.uid || data.userId == request.auth.uid) &&
             (data.get('displayName', '') is string && data.get('displayName', '').size() <= 100) &&
             (data.get('coins', 0) is int && data.get('coins', 0) >= 0) &&
             (data.get('gems', 0) is int && data.get('gems', 0) >= 0) &&
             (data.get('role', 'PLAYER') in ['PLAYER', 'VETERAN', 'AMBASSADOR', 'MODERATOR', 'ADMIN']);
    }

    // --- PUBLIC READ COLLECTIONS ---
    match /system_config/{docId} {
      allow read, get, list: if true;
      allow write: if isAdmin();
    }

    match /character_overrides/{charId} {
      allow read, get, list: if true;
      allow write: if isAdmin();
    }

    match /stage_overrides/{stageId} {
      allow read, get, list: if true;
      allow write: if isAdmin();
    }

    match /engine_overrides/{engineId} {
      allow read, get, list: if true;
      allow write: if isAdmin();
    }

    match /hall_of_fame/{docId} {
      allow read, get, list: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read, get, list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read, get, list: if true;
      allow write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
