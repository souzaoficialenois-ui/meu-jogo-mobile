rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN" || 
         request.auth.token.email == "souzaoficialenois@gmail.com");
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Validation
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.coins is int && data.coins >= 0 &&
             data.gems is int && data.gems >= 0 &&
             data.summonTickets is int && data.summonTickets >= 0 &&
             (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (data.avatarId == null || (data.avatarId is string && data.avatarId.size() <= 50)) &&
             (data.numericId == null || (data.numericId is string && data.numericId.matches('^[0-9]{8}$')))
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Only admins can list users for now
      
      allow create: if isOwner(userId) && 
                       isValidUser(incoming()) && 
                       incoming().role == "PLAYER" &&
                       incoming().isBanned == false &&
                       incoming().createdAt == request.time;
      
      allow update: if isOwner(userId) && 
                       isValidUser(incoming()) && (
                         // Players can update these fields
                         (incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'avatarId', 'coins', 'gems', 'summonTickets', 
                           'rouletteCoins', 'unlockedItems', 'unlockedCharacterIds', 
                           'bannerTokens', 'pityCounters', 'battlePass', 'updatedAt',
                           'wins', 'losses', 'numericId'
                         ]) && 
                         incoming().role == existing().role &&
                         incoming().isBanned == existing().isBanned &&
                         incoming().createdAt == existing().createdAt &&
                         (existing().numericId == null || incoming().numericId == existing().numericId) &&
                         incoming().updatedAt == request.time)
                       ) || isAdmin();
    }

    match /sessions/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /character_overrides/{charId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /stage_overrides/{stageId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /engine_overrides/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
